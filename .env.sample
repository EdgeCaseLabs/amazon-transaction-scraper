# Amazon Scraper Environment Variables
# Copy this file to .env and fill in your values

# Option 1: Use 1Password CLI references (recommended)
# Make sure you're signed in: op signin
OP_ACCOUNT=my
AMAZON_EMAIL="op://vault/itemid/username"
AMAZON_PASSWORD="op://vault/itemid/password"
AMAZON_OTP="op://vault/itemid/one-time password"

# Option 2: Use plain text (not recommended for security)
# AMAZON_EMAIL=your@email.com
# AMAZON_PASSWORD=yourpassword
# AMAZON_OTP=123456

# Notes:
# - OP_ACCOUNT defaults to "my" if not specified
# - ?attribute=otp is automatically appended to AMAZON_OTP op:// references
# - If you provide credentials via .env, you won't be prompted for them
# - Command line --email flag overrides AMAZON_EMAIL
# - If OTP is not provided, you can still enter it manually or wait for manual 2FA
# - .env file is gitignored for security
