{
  "name": "amazon-transaction-scraper",
  "version": "1.0.0",
  "description": "Scrape Amazon transactions and generate human-readable reports",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "scrape": "pnpm run build && node dist/index.js",
    "generate": "pnpm run build && node dist/generator.js",
    "regenerate": "pnpm run build && node dist/regenerate-summaries.js",
    "dev": "ts-node src/index.ts",
    "serve": "ts-node src/serve.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "date-fns": "^3.6.0",
    "fs-extra": "^11.2.0",
    "playwright": "^1.44.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.12.7",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}